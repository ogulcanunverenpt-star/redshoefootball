<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <style>
      body {
        min-height: 100vh;
        background-color: #0b0f19;
        color: #f3f4f6;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }

      .auth-shell {
        min-height: 100vh;
      }

      .auth-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 1.5rem;
        box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.5);
        color: #f3f4f6;
      }

      .brand-icon {
        align-items: center;
        background: linear-gradient(135deg, #00ff9b, #3b82f6);
        border-radius: 1.25rem;
        color: #0b0f19;
        display: inline-flex;
        height: 4rem;
        justify-content: center;
        width: 4rem;
        font-weight: bold;
      }

      .form-control {
        background-color: #1f2937;
        border: 1px solid #374151;
        color: #f3f4f6;
      }

      .form-control:focus {
        background-color: #1f2937;
        border-color: #00ff9b;
        color: #f3f4f6;
        box-shadow: 0 0 0 0.25rem rgba(0, 255, 155, 0.25);
      }

      .text-secondary {
        color: #9ca3af !important;
      }

      .btn-primary {
        background-color: #00ff9b;
        border-color: #00ff9b;
        color: #0b0f19;
        font-weight: bold;
      }

      .btn-primary:hover {
        background-color: #00cc7a;
        border-color: #00cc7a;
        color: #0b0f19;
      }
    </style>
    <title>VideoMeet & 3D Futbol</title>
  </head>
  <body>
    <main class="container auth-shell d-flex align-items-center py-5">
      <div class="w-100"><%- body %></div>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
