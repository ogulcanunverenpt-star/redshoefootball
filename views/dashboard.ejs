<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card auth-card">
      <div class="card-body p-4 p-md-5">
        <div class="d-flex align-items-center gap-3 mb-4">
          <div class="brand-icon flex-shrink-0">
            <i class="fa-solid fa-gauge-high fa-xl"></i>
          </div>
          <div>
            <h1 class="h3 fw-bold mb-1">Dashboard</h1>
            <p class="text-secondary mb-0">Hoş geldiniz, <%= user.name %>.</p>
          </div>
        </div>

        <div class="alert alert-primary mb-4" role="alert">
          Passport yerel kimlik doğrulaması ve SQLite veritabanı aktif.
        </div>

        <div class="d-flex flex-wrap gap-2">
          <a href="/meet" class="btn btn-primary"><i class="fas fa-video me-1"></i> Video Görüşme Başlat</a>
          <a href="/game" class="btn btn-success" target="_blank"><i class="fas fa-gamepad me-1"></i> 3D Futbol Oyununu Oyna</a>
          <a href="/users/logout" class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt me-1"></i> Çıkış Yap</a>
        </div>
      </div>
    </div>
  </div>
</div>
