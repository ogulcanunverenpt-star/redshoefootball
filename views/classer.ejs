<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Video Meet Oda - <%= RoomId %></title>

        <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <link href="//cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <link rel="stylesheet" href="style.css">

        <script type="text/javascript">
            const roomID = "<%= RoomId %>";
            const defaultNickname = "<%= user ? user.name : 'Kullanıcı' %>";
        </script>
        <script src="https://unpkg.com/peerjs@1.3.1/dist/peerjs.min.js" defer></script>
        <script src="socket.io/socket.io.js" defer></script>
        <script src="add-ons.js" defer></script>
        <script src="class.js" charset="utf-8" defer></script>
        <script src="classer.js" charset="utf-8" defer></script>
    </head>
    <body class="bg-light">
        <header class="container-fluid bg-dark text-light py-3 shadow-sm">
            <div class="container-fluid px-4">
                <div class="row align-items-center">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <h2 class="fw-bold mb-1"><i class="fas fa-video text-primary me-2"></i>Oda: <span class="text-info"><%= RoomId %></span></h2>
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-light opacity-75 small">Durumunuz:</span>
                            <span id="roleBadge" class="badge bg-secondary fs-6"><i class="fas fa-spinner fa-spin me-1"></i>Kontrol ediliyor...</span>
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <a href="/meet" class="btn btn-danger me-2"><i class="fas fa-door-open me-1"></i>Odayı Terk Et</a>
                        
                    </div>
                </div>
            </div>
        </header>

        <main class="container-fluid px-4 my-4">
            <!-- Hardware status alert -->
            <div id="mediaAlert" class="alert alert-info alert-dismissible fade show d-none" role="alert">
                <span id="mediaAlertText">Media status</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <div class="row g-4">
                <!-- Video / Audio Grid Section -->
                <div class="col-lg-9 col-md-8">
                    <div class="card border-0 shadow-sm rounded-3 bg-white p-3 min-vh-50">
                        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-3 gap-2">
                            <h4 class="fw-bold text-secondary mb-0"><i class="fas fa-desktop me-2"></i>Yayınlar & Katılımcılar</h4>

                            <!-- Media Controls Toolbar -->
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button id="toggleMicBtn" class="btn btn-outline-primary btn-sm" onclick="toggleMic()" title="Mikrofonu Aç/Kapat">
                                    <i class="fas fa-microphone me-1"></i> Sesi Kapat
                                </button>
                                <button id="toggleCamBtn" class="btn btn-primary btn-sm" onclick="toggleCamera()" title="Kamerayı Aç/Kapat">
                                    <i class="fas fa-video me-1"></i> Kamerayı Aç
                                </button>
                                <button id="switchCamBtn" class="btn btn-outline-secondary btn-sm d-none" onclick="switchCamera()" title="Ön veya Arka Kameraya Geç">
                                    <i class="fas fa-sync-alt me-1"></i> Ön / Arka Kamera
                                </button>
                                <select id="cameraSelect" class="form-select form-select-sm d-none" style="width: auto;" onchange="selectCameraDevice(this.value)" title="Kamera Cihazı Seçin">
                                </select>
                            </div>
                        </div>

                        <div class="row flex-wrap row-videos g-3" id="videoDiv" id="video-container">
                            <!-- Video elements will be dynamically appended here -->
                        </div>
                    </div>
                </div>

                <!-- Participants Sidebar Section -->
                <div class="col-lg-3 col-md-4">
                    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
                        <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">
                            <i class="fas fa-users me-2"></i>Odadakiler (<span id="participantCount">0</span>)
                        </h5>
                        <ul class="list-group list-group-flush overflow-auto" style="max-height: 400px;" id="participantsList">
                            <li class="list-group-item text-muted small">Yükleniyor...</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="alert alert-primary alert-dismissible fade hidden" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </main>


        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    </body>
</html>
