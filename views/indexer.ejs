<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <title>Video Meet & 3D Futbol Lobby</title>

        <script src="socket.io/socket.io.js"></script>
        <script src="add-ons.js" defer></script>
        <script src="indexer.js" defer></script>

        <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <link href="//cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <link rel="stylesheet" href="style.css">
        <style>
            body {
                background-color: #0b0f19;
                color: #f3f4f6;
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
            }
            .dark-card {
                background-color: #111827;
                border: 1px solid #1f2937;
                color: #f3f4f6;
                border-radius: 1rem;
            }
            .form-control, .form-select {
                background-color: #1f2937;
                border: 1px solid #374151;
                color: #f3f4f6;
            }
            .form-control:focus {
                background-color: #1f2937;
                border-color: #00ff9b;
                color: #f3f4f6;
                box-shadow: 0 0 0 0.25rem rgba(0, 255, 155, 0.25);
            }
        </style>
    </head>
    <body class="bg-dark text-light">
      
        <main class="container my-4">
            <!-- Room Creation / Quick Join Card -->
            <div class="row justify-content-center mb-5">
                <div class="col-lg-8">
                    <div class="dark-card p-4 shadow-lg">
                        <h4 class="fw-bold mb-3 text-success"><i class="fas fa-door-open me-2"></i>Yeni Video Görüşme Odası Başlat</h4>
                        <form id="joinRoomForm" onsubmit="handleJoinRoom(event)">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label for="nicknameInput" class="form-label small fw-semibold text-secondary">Takma Ad (Nickname)</label>
                                    <input type="text" class="form-control" id="nicknameInput" value="<%= user ? user.name : '' %>" placeholder="Adınız" required>
                                </div>
                                <div class="col-md-5">
                                    <label for="roomIdInput" class="form-label small fw-semibold text-secondary">Oda Adı / ID</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="roomIdInput" value="<%= RoomId %>" placeholder="Oda ID" required>
                                        <button class="btn btn-outline-secondary text-light" type="button" onclick="generateNewRoomId()" title="Rastgele ID"><i class="fas fa-random"></i></button>
                                    </div>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-success w-100 fw-bold"><i class="fas fa-arrow-right"></i></button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Active Video Meet Rooms Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0 text-white fs-4">
                    <i class="fas fa-broadcast-tower text-success me-2"></i>Aktif Video Görüşme Odaları
                </h3>
                <button class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="refreshRooms()">
                    <i class="fas fa-sync-alt me-1"></i>Yenile
                </button>
            </div>

            <div class="row g-3 mb-5" id="activeRoomsContainer">
                <div class="col-12 text-center py-4">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <p class="text-secondary mt-2 small">Aktif odalar taranıyor...</p>
                </div>
            </div>

            <!-- Active 3D Football Matches Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0 text-white fs-4">
                    <i class="fas fa-futbol text-primary me-2"></i>3D Futbol Stadyum Maçları
                </h3>
                <a href="/game" class="btn btn-outline-primary btn-sm rounded-pill px-3" target="_blank">
                    <i class="fas fa-play me-1"></i>Maç Başlat
                </a>
            </div>

            <div class="row g-3">
                <div class="col-md-6 col-lg-4">
                    <div class="dark-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-white mb-0"><i class="fas fa-shield-halved text-success me-2"></i>Saha-1 (Ana Stadyum)</h5>
                            <span class="badge bg-success">Açık Maç</span>
                        </div>
                        <p class="text-secondary small mb-3">3D Stadyum, Şut/Pas mekanikleri, Canlı Sesli Sohbet ve PatronTV ekran paylaşımı aktif.</p>
                        <a href="/game" class="btn btn-success w-100 fw-bold mt-auto" target="_blank">
                            <i class="fas fa-sign-in-alt me-1"></i> Maça Katıl
                        </a>
                    </div>
                </div>
            </div>

            <div class="alert alert-success alert-dismissible fade hidden" role="alert" style="position:fixed; bottom:20px; right:20px; z-index:1080;">
                <span id="alertMessage">URL kopyalandı!</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </main>


        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    </body>
</html>
